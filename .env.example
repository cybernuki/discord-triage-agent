# Copy to .env and fill in. Never commit .env.

# --- Discord (required) ---
# Bot token from the Discord Developer Portal. Enable the "Message Content" privileged intent.
DISCORD_TOKEN=
# Comma-separated IDs of the support channels the bot listens to.
SUPPORT_CHANNEL_IDS=
# Optional: register slash commands for one server only (instant). Leave empty for global (up to ~1h to appear).
DISCORD_GUILD_ID=

# --- TypeSafe / Jev (required) ---
# API key for the classifier. https://docs.typesafe.ai
TYPESAFE_API_KEY=

# --- Triage policy ---
# Minimum category confidence (0..1). Below it the message becomes "other" and is routed to a human.
TRIAGE_CONFIDENCE_THRESHOLD=0.6

# --- Answer agent (optional) ---
# on | off. When on, confident "question" messages get a draft answer from the knowledge/ folder.
ANSWER_AGENT=off
# Required when ANSWER_AGENT=on. A Claude model ID or inference profile enabled in your Bedrock account.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
# Bedrock credentials use the standard AWS chain. Set ONE of:
#   AWS_BEARER_TOKEN_BEDROCK=            (Bedrock API key)
#   AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / AWS_SESSION_TOKEN=
# or run with an IAM role / profile.
AWS_BEARER_TOKEN_BEDROCK=

# Folder of markdown FAQs (relative to the working directory).
KNOWLEDGE_DIR=knowledge

# --- Build metadata (optional) ---
# Short git commit shown by /version. Docker: --build-arg BUILD_COMMIT=$(git rev-parse --short HEAD)
BUILD_COMMIT=
